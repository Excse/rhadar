{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/vscode/debug",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DBUILD_SHARED_LIBS=OFF",
                "-DBUILD_TESTING=ON",
                "-DMAKE_INSTALLABLE=ON",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/vscode/debug",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "CMake: Configure Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake: Test Debug",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/vscode/debug",
                "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "CMake: Build Debug",
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "CMake: Install Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--install",
                "${workspaceFolder}/build/vscode/debug",
                "--prefix",
                "${workspaceFolder}/build/vscode/install/debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "CMake: Build Debug",
            "dependsOrder": "sequence"
        },
        {
            "label": "CMake: Clean Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/vscode/debug",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "CMake: Configure Debug",
            "dependsOrder": "sequence"
        },
        {
            "label": "CMake: Configure Release",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/vscode/release",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_SHARED_LIBS=OFF",
                "-DBUILD_TESTING=ON",
                "-DMAKE_INSTALLABLE=ON",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/vscode/release",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "CMake: Configure Release",
            "dependsOrder": "sequence",
            "group": "build"
        },
        {
            "label": "CMake: Test Release",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/vscode/release",
                "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "CMake: Build Release",
            "dependsOrder": "sequence",
            "group": "test"
        },
        {
            "label": "CMake: Install Release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--install",
                "${workspaceFolder}/build/vscode/release",
                "--prefix",
                "${workspaceFolder}/build/vscode/install/release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "CMake: Build Release",
            "dependsOrder": "sequence"
        },
        {
            "label": "CMake: Clean Release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/vscode/release",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "CMake: Configure Release",
            "dependsOrder": "sequence"
        },
        {
            "label": "CMake: Configure Shared",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/vscode/shared",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DBUILD_SHARED_LIBS=ON",
                "-DBUILD_TESTING=ON",
                "-DMAKE_INSTALLABLE=ON",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Shared",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/vscode/shared",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "CMake: Configure Shared",
            "dependsOrder": "sequence",
            "group": "build"
        },
        {
            "label": "CMake: Test Shared",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir",
                "${workspaceFolder}/build/vscode/shared",
                "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "CMake: Build Shared",
            "dependsOrder": "sequence",
            "group": "test"
        },
        {
            "label": "CMake: Install Shared",
            "type": "process",
            "command": "cmake",
            "args": [
                "--install",
                "${workspaceFolder}/build/vscode/shared",
                "--prefix",
                "${workspaceFolder}/build/vscode/install/shared"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "CMake: Build Shared",
            "dependsOrder": "sequence"
        },
        {
            "label": "CMake: Clean Shared",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/vscode/shared",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "CMake: Configure Shared",
            "dependsOrder": "sequence"
        },
        {
            "label": "Documentation: Generate",
            "type": "process",
            "command": "doxygen",
            "args": [
                "Doxyfile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
