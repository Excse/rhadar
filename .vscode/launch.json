{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Tests: Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/vscode/debug/tests/rhadar_tests",
            "args": [
                "--gtest_filter=${input:testFilter}"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "preLaunchTask": "CMake: Build Debug"
        }
    ],
    "inputs": [
        {
            "id": "testFilter",
            "type": "promptString",
            "description": "GoogleTest filter (* runs all tests)",
            "default": "*"
        }
    ]
}
